# RSV360 — Reservei Viagens
# Arquivo .env para desenvolvimento e testes E2E

# ─── Servidor ───────────────────────────────────────────────────────────────
PORT=5000
SESSION_SECRET=development-session-secret-change-in-production
SESSION_COOKIE_SECURE=false
REDIS_URL=redis://127.0.0.1:6379
REDIS_SESSION_PREFIX=rsv360:sess:

# ─── Voucher ────────────────────────────────────────────────────────────────
VOUCHER_SECRET=development-voucher-secret-change-in-production

# ─── Gateway de Pagamento ───────────────────────────────────────────────────
GATEWAY_API_URL=https://api.seugateway.com.br
GATEWAY_API_KEY=demo-key
WEBHOOK_SECRET=demo-webhook-secret
WEBHOOK_PAYMENT_SECRET=demo-webhook-payment-secret

# ─── WhatsApp (Evolution API) ────────────────────────────────────────────────
EVOLUTION_API_URL=https://api.evolution.seudominio.com.br
EVOLUTION_API_KEY=demo-evolution-key
EVOLUTION_INSTANCE_NAME=CaldasMaster

# ─── E-mail (SMTP) ───────────────────────────────────────────────────────────
SMTP_HOST=smtp.seudominio.com.br
SMTP_PORT=587
SMTP_USER=noreply@seudominio.com.br
SMTP_PASS=demo-smtp-pass
SMTP_FROM=RSV360 <noreply@seudominio.com.br>

# ─── Integrações ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-demo
GOOGLE_MAPS_API_KEY=AIza-demo

# ─── Ambiente ────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Demo e Debug ────────────────────────────────────────────────────────────
DEMO_CONFIRM_DELAY_MS=0

# ─── Banco de Dados ──────────────────────────────────────────────────────────
# Para desenvolvimento local, use PostgreSQL local ou uma instância de teste
# DATABASE_URL=postgresql://username:password@localhost:5432/rsv360_dev
# Para testes E2E, usar SQLite em memória ou um banco de teste
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rsv360_crm
